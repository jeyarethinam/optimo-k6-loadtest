  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body?.meta?.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    pm.test('Token received', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "} else {",
                  "    pm.test('Token received', () => pm.expect.fail('No token in response meta'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v4.1/users/login?fields=token",
              "host": ["{{base_url}}"],
              "path": ["api", "v4.1", "users", "login"],
              "query": [{ "key": "fields", "value": "token" }]
            },
            "description": "Authenticate and store token in collection variable."
          }
        }
      ]
    },
