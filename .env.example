# Copy to `.env` and fill in values:
#   copy .env.example .env
#
# Both ECOM and WCC runners load this file automatically.

# ── ECOM ──────────────────────────────────────────────
BASE_URL=https://your-ecom-host/restapi
USERNAME=your-ecom-username
PASSWORD=your-ecom-password
# Optional report label
# ENV_NAME=ECOM-UAT

# Optional ECOM overrides
# PACKAGE_IDS=7663,7662,7661,...,7614
# ECOM_PACKAGE_ID=7663
# ECOM_PACKAGE_START=2028-07-04T08:00:00
# ECOM_PACKAGE_END=2028-07-04T17:00:00
# ECOM_PRICE_CONCESSION_ID=8
# ECOM_SALES_CHANNEL_ID=1
# CONTACT_ID=
# CONTACT_EMAIL=
# ACCOUNT_MANAGER_ID=2

# Optional pacing (passed to k6 via runner)
# THINK_TIME_ENABLED=1          # 0 = no pause between API calls
# THINK_TIME_MIN_S=0.2          # random pause min (seconds) after each request
# THINK_TIME_MAX_S=1.0          # random pause max (seconds) after each request
# ITERATION_DELAY_S=0           # fixed pause (seconds) after each full booking flow

# ── WCC ───────────────────────────────────────────────
WCC_BASE_URL=https://wcc-uat.optimo.training/restapi
WCC_LOGIN_USER=your-wcc-username
WCC_LOGIN_PASSWORD=your-wcc-password

# Optional WCC load / smoke cohort logins
# WCC_LOAD_LOGIN_USER=
# WCC_LOAD_LOGIN_PASSWORD=
# WCC_SMOKE_SIMPLE_LOGIN_USER=
# WCC_SMOKE_SIMPLE_LOGIN_PASSWORD=
# WCC_SMOKE_COMPLEX_LOGIN_USER=
# WCC_SMOKE_COMPLEX_LOGIN_PASSWORD=
# WCC_FLOW=both

# ── HRP ───────────────────────────────────────────────
# Falls back to BASE_URL / USERNAME / PASSWORD when unset
# HRP_BASE_URL=https://your-host/restapi
# HRP_USERNAME=
# HRP_PASSWORD=
HRP_CONTACT_ID=7321
HRP_CLIENT_REF=CO00007168
# HRP_PACKAGE_IDS=7663,7662,7661,...   # defaults to 50 IDs in HRP/data.js
# HRP_EVENT_FROM=2028-07-14
# HRP_EVENT_TO=2028-07-30
# HRP_SKIP_CANCEL=false
# HRP_SKIP_UNSUBMIT=false

# ── NSC (Play booking portal) ─────────────────────────
NSC_ORIGIN=https://nsc-play-booking-portal.azurewebsites.net
# Or full API base (runner strips /bookingportal/api):
# NSC_BASE_URL=https://nsc-play-booking-portal.azurewebsites.net/bookingportal/api
NSC_TEST_EMAIL_1=your-nsc-uat-user@example.com
# NSC_TEST_EMAIL_2=
# NSC_TEST_EMAIL_3=
NSC_TEST_PASSWORD=your-nsc-uat-password
# ENV_NAME=NSC-UAT
# NSC_PACKAGE_ID=58
# NSC_ITEM_ID=2156
# NSC_ASSET_ID=586
# NSC_FROM_DATE=2026-11-03
# NSC_TO_DATE=2026-11-10
# NSC_SCAN_DAYS=7
# ENABLE_RETRIES=0
# THINK_TIME_ENABLED=1
# THINK_TIME_MIN_S=0.2
# THINK_TIME_MAX_S=0.5
# ITERATION_DELAY_S=0
