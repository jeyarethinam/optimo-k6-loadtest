# Copy to `.env` and fill in values:
#   copy .env.example .env
#
# Both LA28 and WCC runners load this file automatically.

# ── LA28 ──────────────────────────────────────────────
BASE_URL=https://your-la28-host/restapi
USERNAME=your-la28-username
PASSWORD=your-la28-password
# Optional report label
# ENV_NAME=LA28-UAT

# Optional LA28 overrides
# PACKAGE_IDS=
# CONTACT_ID=
# CONTACT_EMAIL=
# ACCOUNT_MANAGER_ID=2

# ── WCC ───────────────────────────────────────────────
WCC_BASE_URL=https://wcc-uat.optimo.training/restapi
WCC_LOGIN_USER=your-wcc-username
WCC_LOGIN_PASSWORD=your-wcc-password

# Optional WCC load / smoke cohort logins
# WCC_LOAD_LOGIN_USER=
# WCC_LOAD_LOGIN_PASSWORD=
# WCC_SMOKE_SIMPLE_LOGIN_USER=
# WCC_SMOKE_SIMPLE_LOGIN_PASSWORD=
# WCC_SMOKE_COMPLEX_LOGIN_USER=
# WCC_SMOKE_COMPLEX_LOGIN_PASSWORD=
# WCC_FLOW=both

# ── HRP ───────────────────────────────────────────────
# Falls back to BASE_URL / USERNAME / PASSWORD when unset
# HRP_BASE_URL=https://your-host/restapi
# HRP_USERNAME=
# HRP_PASSWORD=
HRP_CONTACT_ID=7321
HRP_CLIENT_REF=CO00007168
# HRP_PACKAGE_IDS=7663,7662,7661,...   # defaults to 50 IDs in HRP/data.js
# HRP_EVENT_FROM=2028-07-14
# HRP_EVENT_TO=2028-07-30
# HRP_SKIP_CANCEL=false
# HRP_SKIP_UNSUBMIT=false
